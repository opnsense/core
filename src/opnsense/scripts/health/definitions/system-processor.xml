<?xml version="1.0"?>
<systemhealth>
    <file-match>system-processor</file-match>
    <title> System Information - Utilization and Processes</title>
    <y-axis_label>[U]tilization ,  [#]Number</y-axis_label>
    <axis_labels>
        <y>CPU utilization (%)</y>
        <y1>Processes/threads</y1>
    </axis_labels>
    <field_axes>
        <user>y</user>
        <nice>y</nice>
        <system>y</system>
        <interrupt>y</interrupt>
        <processes>y1</processes>
    </field_axes>
    <field_units>
        <user>%</user>
        <nice>%</nice>
        <system>%</system>
        <interrupt>%</interrupt>
        <processes>processes/threads</processes>
    </field_units>
</systemhealth>
