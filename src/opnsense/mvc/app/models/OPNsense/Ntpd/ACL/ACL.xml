<acl>
    <page-services-ntpd>
        <name>Services: NTP</name>
        <patterns>
            <pattern>ui/ntpd/settings/*</pattern>
            <pattern>api/ntpd/settings/*</pattern>
            <pattern>api/ntpd/service/*</pattern>
        </patterns>
    </page-services-ntpd>
    <page-status-ntp>
        <name>Status: NTP</name>
        <patterns>
            <pattern>ui/ntpd/status/*</pattern>
            <pattern>api/ntpd/service/meta</pattern>
            <pattern>api/ntpd/service/gps</pattern>
            <pattern>api/ntpd/service/searchPeers</pattern>
        </patterns>
    </page-status-ntp>
    <page-status-systemlogs-ntpd>
        <name>Status: System logs: NTP</name>
        <patterns>
            <pattern>ui/diagnostics/log/core/ntpd/*</pattern>
            <pattern>api/diagnostics/log/core/ntpd/*</pattern>
        </patterns>
    </page-status-systemlogs-ntpd>
</acl>
