<model>
    <mount>/wireless/clone+</mount>
    <version>1.0.0</version>
    <description>Wireless configuration</description>
    <items>
        <clone type="ArrayField">
            <if type="JsonKeyValueStoreField">
                <Required>Y</Required>
                <ConfigdPopulateAct>interface list wireless-adapters</ConfigdPopulateAct>
                <ValidationMessage>Specify a valid wireless device.</ValidationMessage>
            </if>
            <mode type="OptionField">
                <Required>Y</Required>
                <Default>bss</Default>
                <OptionValues>
                    <bss>Infrastructure (BSS)</bss>
                    <adhoc>Ad-hoc (IBSS)</adhoc>
                    <hostap>Access Point</hostap>
                </OptionValues>
            </mode>
            <descr type="DescriptionField"/>
            <cloneif type="TextField"/>
        </clone>
    </items>
</model>
