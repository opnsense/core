<acl>
    <page-hostdiscovery>
        <name>Interfaces: Hostwatch</name>
        <description>Allow access to the hostdiscovery server</description>
        <patterns>
            <pattern>ui/hostdiscovery/settings</pattern>
            <pattern>api/hostdiscovery/settings/*</pattern>
            <pattern>api/hostdiscovery/service/*</pattern>
            <pattern>api/diagnostics/dns/reverse_lookup*</pattern>
            <pattern>api/diagnostics/firewall/query_pf_top</pattern>
            <pattern>ui/hostdiscovery/settings</pattern>
        </patterns>
    </page-hostdiscovery>
    <page-diagnostics-logs-hostdiscovery>
        <name>Interfaces: Hostwatch: Log File</name>
        <description>Allow access to the host discovery Log File</description>
        <patterns>
            <pattern>ui/diagnostics/log/core/hostwatch/*</pattern>
            <pattern>api/diagnostics/log/core/hostwatch/*</pattern>
        </patterns>
    </page-diagnostics-logs-hostdiscovery>
</acl>
