<model>
    <mount>//OPNsense/Service</mount>
    <version>1.0.1</version>
    <description>Service settings</description>
    <items>
        <supervisor type=".\SupervisorField">
            <Multiple>Y</Multiple>
        </supervisor>
        <restart_count type="IntegerField">
            <Required>Y</Required>
            <Default>5</Default>
            <MinimumValue>0</MinimumValue>
            <MaximumValue>128</MaximumValue>
        </restart_count>
        <restart_delay type="IntegerField">
            <Required>Y</Required>
            <Default>10</Default>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>31536000</MaximumValue>
        </restart_delay>
    </items>
</model>
