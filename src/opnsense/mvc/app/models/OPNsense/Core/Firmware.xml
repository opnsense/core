<model>
    <mount>//system/firmware</mount>
    <version>1.0.1</version>
    <description>Firmware settings</description>
    <items>
        <mirror type="TextField">
            <ValidationMessage>The mirror URL cannot contain literal double quotes or pipe characters.</ValidationMessage>
            <Mask>/[^|"]+/</Mask>
        </mirror>
        <flavour type="TextField"/>
        <plugins type="TextField"/>
        <type type="TextField"/>
        <subscription type="TextField"/>
        <reboot type="BooleanField"/>
        <aux type="BooleanField"/>
    </items>
</model>
