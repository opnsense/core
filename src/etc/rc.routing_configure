require_once 'config.inc';
require_once 'util.inc';
require_once 'system.inc';
require_once 'interfaces.inc';
require_once 'filter.inc';

exit_on_bootup();

/* when called with an argument we are in gateway switch mode */
$monitor_hook = !empty($argv[1]);
$monitor_gws = !empty($argv[2]) ? explode(',', $argv[2]) : [];
$monitor_data = null;

/* routing is not allowed to restart monitors when extended hook is requested */
system_routing_configure(true, null, !$monitor_hook);

if ($monitor_hook) {
    /* make a copy of the current content before modifying dpinger in the hook */
    $monitor_data = return_gateways_status();

    /*
     * XXX We should dump the $monitor_data into a temporary JSON file and
     * or use an environment variable to point ot the file for subsequent
     * calls of return_gateways_status() which also matters for the
     * filter_configure_sync() call below.
     */

    /* pass down gateways in a shell compatible way as a single argument */
    pass_safe('/usr/local/etc/rc.syshook monitor %s', implode(',', $monitor_gws));
}

/* XXX would have to use $monitor_data if set, see above */
filter_configure_sync(true, false);

/* XXX monitor data doesn't have to be passed if we use something more clever */
filter_gateway_states($monitor_gws, $monitor_data);
