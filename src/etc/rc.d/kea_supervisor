# PROVIDE: kea_supervisor
# REQUIRE: kea
# KEYWORD: shutdown

. /etc/rc.subr
. /usr/local/opnsense/scripts/service/supervisor.subr.sh

name=kea_supervisor
rcvar=kea_supervisor_enable
supervisor_profiles="dhcp4 dhcp6 dhcp_ddns ctrl_agent prefix_watcher"
supervisor_profile_configure=kea_supervisor_configure
supervisor_profile_enabled=kea_supervisor_enabled
supervisor_profiles_fallback=/usr/local/etc/rc.d/kea

load_rc_config kea
. /usr/local/etc/kea/keactrl.conf

: ${kea_supervisor_enable:=NO}

kea_supervisor_configure()
{
    local config_name

    if [ "$1" = prefix_watcher ]; then
        name=kea_prefix_watcher
        command=/usr/local/opnsense/scripts/kea/kea_prefix_watcher.py
        command_interpreter=/usr/local/bin/python3
        pidfile=/var/run/kea_prefix_watcher.pid
        command_args=
        required_files=${command}
        return
    fi

    eval "command=\${${1}_srv}"
    eval "config=\${kea_${1}_config_file}"
    [ -n "${command}" ] && [ -n "${config}" ] || return 1

    name="kea_${1}"
    config_name=${config##*/}
    config_name=${config_name%.*}
    pidfile="/var/run/kea/${config_name}.${command##*/}.pid"
    command_args="-c ${config}"
    required_files=${config}
}

kea_supervisor_enabled()
{
    local enabled

    if [ "$1" = prefix_watcher ]; then
        [ "${dhcp6}" = yes ]
        return
    fi

    eval "enabled=\${$1}"
    [ "${enabled}" = yes ]
}

kea_supervisor_precmd()
{
    /usr/local/opnsense/scripts/kea/setup.sh
}

start_precmd=kea_supervisor_precmd
supervisor_profiles_enable
run_rc_command "$1"
